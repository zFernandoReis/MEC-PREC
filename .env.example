POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mec_system
LOG_LEVEL=INFO
# Gere um segredo aleatório de pelo menos 32 caracteres; não use este exemplo.
JWT_SECRET_KEY=
JWT_ISSUER=mec-system
JWT_AUDIENCE=mec-system-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Docker Compose: host/porta internos do banco são definidos pelo Compose.
APP_PORT=8000
POSTGRES_EXTERNAL_PORT=5432
TZ=America/Sao_Paulo
NOTIFICATION_DAYS_BEFORE=3
NOTIFICATION_BATCH_SIZE=100
# Opcional: senha de pelo menos 12 caracteres para usuários do JSON sem password.
MEC_INITIAL_PASSWORD=
